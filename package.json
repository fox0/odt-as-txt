{
  "name": "odt-as-txt",
  "version": "0.1.0",
  "license": "MIT",
  "type": "commonjs",
  "displayName": "odt-as-txt",
  "description": "odt-as-txt",
  "publisher": "fox0",
  "repository": "https://github.com/fox0/odt-as-txt",
  "activationEvents": [
    "onCustomEditor:odtViewer.readonly"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "odtViewer.readonly",
        "displayName": "ODT Viewer (read-only)",
        "selector": [
          {
            "filenamePattern": "*.odt"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "npx tsc"
  },
  "engines": {
    "vscode": "^1.137.0"
  },
  "dependencies": {
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/node": "^20.19.2",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  }
}