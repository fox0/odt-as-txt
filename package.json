{
  "name": "odt-as-txt",
  "version": "0.1.11",
  "license": "MIT",
  "type": "commonjs",
  "displayName": "odt-as-txt",
  "description": "odt-as-txt",
  "publisher": "fox0",
  "repository": "https://github.com/fox0/odt-as-txt",
  "activationEvents": [
    "onCustomEditor:odtViewer.readonly"
  ],
  "contributes": {
    "commands": [
      {
        "command": "odtViewer.open",
        "title": "Open as Markdown"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "odtViewer.open",
          "when": "resourceExtname == .odt",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "odtViewer.open",
          "when": "false"
        }
      ]
    }
  },
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "npx tsc",
    "test": "vitest run",
    "pack": "npx @vscode/vsce package"
  },
  "engines": {
    "vscode": "^1.137.0"
  },
  "dependencies": {
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.2",
    "@types/vscode": "^1.137.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}